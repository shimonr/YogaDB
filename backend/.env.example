# Copy this file to backend/.env and edit values for your machine.
# Relative paths are resolved from backend/ (this folder), so the defaults survive moving the project.

APP_NAME=Yoga DB API
ENV=development
# true returns full tracebacks in API error responses — never enable it on a public server.
DEBUG=false
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite file is created in backend/ when uvicorn runs from backend/
DATABASE_URL=sqlite:///./yogadb.db

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173

# Password for the seeded admin user "shimon" (required in production).
ADMIN_PASSWORD=adm

# Asana inventory CSV (same format as yoga-image-collector's yoga_asanas.csv).
# The sample has 10 common poses and no images.
ASANAS_CSV_PATH=../data/asanas/yoga_asanas.sample.csv

# Root folder of per-asana image subfolders named after the English pose name, e.g. Mountain_Pose/
ASANAS_IMAGES_DIR=../data/asanas
