# Oracle Cloud VM deployment settings (not secret). Secrets live on the server in
# $APP_DIR/deploy/oracle/.env, generated on the first deploy.
SSH_TARGET=ubuntu@129.159.8.242
APP_DIR=/opt/apps/yogadb
BRANCH=master
# Free hostname that resolves to the VM's IP (sslip.io); replace with your own domain later.
DOMAIN=yogadb.129-159-8-242.sslip.io
REPO_URL=https://github.com/shimonr/YogaDB.git
# Asana CSV and image folders on the Windows PC, uploaded by upload-photos.cmd.
PHOTOS_CSV=D:\DEV\yoga-image-collector\input\yoga_asanas.csv
PHOTOS_DIR=D:\DEV\yoga-image-collector\asana_images
