# QA stack: a second copy of YogaDB on the same VM with its own database, for testing.
# Deploy with `scripts/deploy.sh qa` or deploy-qa.cmd. Values here override config.env.
APP_DIR=/opt/apps/yogadb-qa
PROJECT=yogadb-qa
DOMAIN=qa.yogadb.129-159-8-242.sslip.io
# Keep QA's asanas/photos in sync with the uploaded data and give testers sample content.
IMPORT_ON_DEPLOY=1
SEED_SAMPLE_CONTENT=1
# Admin "reset QA to a clean state" button, and a test mailbox (https://mail.<DOMAIN>, user "qa",
# password MAILPIT_PASSWORD in the QA .env) that receives the password reset emails.
QA_MODE=1
MAILPIT=1
